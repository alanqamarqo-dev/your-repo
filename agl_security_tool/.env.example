# AGL Security Tool - Environment Configuration
# Copy to .env and fill in your values
# ================================================

# ── General ──
AGL_DEBUG=false
AGL_LOG_LEVEL=INFO
AGL_LOG_FILE=              # empty = stdout only; set path for file logging
AGL_LOG_FORMAT=text        # text | json

# ── Analysis Timeouts (seconds) ──
AGL_Z3_TIMEOUT=30
AGL_MYTHRIL_TIMEOUT=120
AGL_SLITHER_TIMEOUT=60
AGL_SEMGREP_TIMEOUT=60
AGL_PIPELINE_TIMEOUT=300

# ── API Server ──
AGL_API_HOST=0.0.0.0
AGL_API_PORT=8000
AGL_WORKERS=2
AGL_RATE_LIMIT=30/minute
AGL_CORS_ORIGINS=          # comma-separated origins, empty = no CORS

# ── Auth (REQUIRED for production) ──
AGL_SECRET_KEY=            # CHANGE THIS — use: python -c "import secrets; print(secrets.token_hex(32))"
AGL_JWT_ALGORITHM=HS256
AGL_JWT_EXPIRY_HOURS=24

# ── Database ──
AGL_DATABASE_URL=sqlite:///agl_security.db
AGL_MONGO_URI=             # optional: mongodb://localhost:27017/agl

# ── External Tools (optional) ──
AGL_SOLC_PATH=             # path to solc binary
AGL_RPC_URL=               # Ethereum RPC for on-chain context
AGL_ETHERSCAN_API_KEY=     # for source code verification

# ── Paths ──
AGL_ARTIFACTS_DIR=         # default: ./artifacts
AGL_REPORTS_DIR=           # default: ./reports
